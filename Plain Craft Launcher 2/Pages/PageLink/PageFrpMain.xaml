<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageFrpMain"
             d:DesignWidth="820" d:DesignHeight="820">
    <Grid Margin="25,15,25,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="纯 FRP 联机方案（入门）" FontSize="22" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="通过 frpc 将内网服务器映射到公网：支持导入 ini / toml 配置文件，或手动粘贴配置文本，适合已拥有 FRP 节点的玩家。"
                   FontSize="13" Foreground="{StaticResource ColorBrushGray3}" Margin="0,37,0,10" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <local:MyRadioButton x:Name="BtnFrpTabServer" Text="服务方" Margin="0,0,10,0" Padding="12,6" />
            <local:MyRadioButton x:Name="BtnFrpTabLog" Text="日志输出" Margin="0,0,10,0" Padding="12,6" />
            <local:MyRadioButton x:Name="BtnFrpTabPanel" Text="控制台" Margin="0,0,10,0" Padding="12,6" />
        </StackPanel>

        <!-- 服务方 -->
        <ScrollViewer Grid.Row="2" x:Name="PanFrpServer" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="frpc 客户端" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnFrpDownload" Text="自动下载 frpc" Padding="13,7" ColorType="Highlight" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnFrpOpenFolder" Text="打开工具目录" Padding="13,7" Margin="0,0,18,0" />
                            <TextBlock x:Name="LabFrpFrpc" Text="尚未下载" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="自动从 GitHub 获取最新版 frp（windows_amd64）并解压到本地工具目录；若已有 frpc，可直接把文件放入工具目录后点击启动。"
                                   FontSize="12" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="配置来源" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyCard x:Name="CardFrpIni" Grid.Column="0" Cursor="Hand">
                                <StackPanel x:Name="SpFrpIniInner" Margin="13,11" Opacity="0.55">
                                    <TextBlock Text="导入 ini 配置文件模式" FontSize="14" Foreground="{DynamicResource ColorBrush1}" />
                                    <TextBlock Text="选择服务商导出的 ini / toml 配置文件，一键启动映射。" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                                </StackPanel>
                            </local:MyCard>
                            <local:MyCard x:Name="CardFrpPaste" Grid.Column="2" Cursor="Hand">
                                <StackPanel x:Name="SpFrpPasteInner" Margin="13,11" Opacity="0.55">
                                    <TextBlock Text="手动粘贴 txt 代码" FontSize="14" Foreground="{DynamicResource ColorBrush1}" />
                                    <TextBlock Text="将 frpc 配置文本直接粘贴到输入框中即可使用。" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="17" />
                                </StackPanel>
                            </local:MyCard>
                        </Grid>

                        <StackPanel x:Name="PanFrpIni" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,10">
                            <local:MyButton x:Name="BtnFrpChooseFile" Text="选择配置文件" Padding="13,7" Margin="0,0,12,0" />
                            <TextBlock x:Name="LabFrpFilePath" Text="未选择文件" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox x:Name="TxtFrpPaste" Visibility="Collapsed" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Padding="8"
                                 Background="{StaticResource ColorBrushBg1}" Foreground="{StaticResource ColorBrushGray1}" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="启动控制" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnFrpStart" Text="启动映射" Padding="20,8" ColorType="Highlight" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnFrpStop" Text="停止映射" Padding="20,8" ColorType="Red" Margin="0,0,18,0" />
                            <TextBlock x:Name="LabFrpState" Text="状态：未运行" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource ColorBrushGray2}" />
                        </StackPanel>
                        <TextBlock Text="启动后请切换到【控制台】页面查看 frpc 的实时输出；日志中出现 proxy startup success 即代表映射成功，可使用节点地址联机。"
                                   FontSize="12" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </ScrollViewer>

        <!-- 日志输出 -->
        <Grid x:Name="PanFrpLog" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:MyButton x:Name="BtnFrpLogClear" Grid.Row="0" Text="清空日志" HorizontalAlignment="Right" Margin="0,0,0,8" Padding="13,7" />
            <TextBox x:Name="TxtFrpLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource ColorBrushBg1}" Foreground="{StaticResource ColorBrushGray1}" FontFamily="Consolas" FontSize="12" Padding="10" />
        </Grid>

        <!-- 控制台 -->
        <Grid x:Name="PanFrpPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                <TextBlock x:Name="LabFrpConsState" Text="● 已停止" VerticalAlignment="Center" FontSize="13" Margin="0,0,14,0" />
                <TextBlock x:Name="LabFrpConsInfo" Text="" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <TextBox x:Name="TxtFrpConsole" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Foreground="#5FD75F" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" SelectionBrush="#3F7F3F" />
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabFrpHint" Text="frpc 不支持指令交互，可使用右侧按钮管理映射。" Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
                <local:MyButton x:Name="BtnFrpRestart" Grid.Column="1" Text="重启映射" Padding="16,7" ColorType="Highlight" Margin="0,0,10,0" />
                <local:MyButton x:Name="BtnFrpMore" Grid.Column="2" Text="更多操作" Padding="16,7" Margin="0,0,10,0">
                    <local:MyButton.ContextMenu>
                        <ContextMenu>
                            <local:MyMenuItem x:Name="MenuFrpClear" Header="清空控制台" />
                            <local:MyMenuItem x:Name="MenuFrpFolder" Header="打开工具目录" />
                        </ContextMenu>
                    </local:MyButton.ContextMenu>
                </local:MyButton>
                <local:MyButton x:Name="BtnFrpStop2" Grid.Column="3" Text="停止映射" Padding="16,7" ColorType="Red" />
            </Grid>
        </Grid>
    </Grid>
</local:MyPageRight>
