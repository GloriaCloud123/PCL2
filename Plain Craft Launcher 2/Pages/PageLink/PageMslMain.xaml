<local:MyPageRight
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Class="PageMslMain"
             d:DesignWidth="820" d:DesignHeight="820">
    <Grid Margin="25,15,25,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="服务器 MSL 方案（新手推荐）" FontSize="22" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,4" />
        <TextBlock Grid.Row="0" Text="内置 MSL 开服功能：管理服务端核心与运行环境，一键启动服务器，并在控制台中直接发送指令、查看实时输出。"
                   FontSize="13" Foreground="{StaticResource ColorBrushGray3}" Margin="0,37,0,10" TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <local:MyRadioButton x:Name="BtnTabServer" Text="服务方" Margin="0,0,10,0" Padding="12,6" />
            <local:MyRadioButton x:Name="BtnTabLog" Text="日志输出" Margin="0,0,10,0" Padding="12,6" />
            <local:MyRadioButton x:Name="BtnTabPanel" Text="控制台" Margin="0,0,10,0" Padding="12,6" />
        </StackPanel>

        <!-- 服务方 -->
        <ScrollViewer Grid.Row="2" x:Name="PanServer" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="服务端核心" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="核心文件" Width="84" VerticalAlignment="Center" />
                            <local:MyButton x:Name="BtnMslCoreSelect" Text="选择核心文件" Padding="13,7" Margin="0,0,12,0" />
                            <TextBlock x:Name="LabMslCore" Text="未选择核心（可在线下载原版服务端）" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="在线下载" Width="84" VerticalAlignment="Center" />
                            <local:MyComboBox x:Name="ComboMslVersion" Width="180" Margin="0,0,10,0" ToolTip="若列表为空，请点击刷新列表" />
                            <local:MyButton x:Name="BtnMslRefresh" Text="刷新列表" Padding="13,7" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnMslCoreDownload" Text="下载服务端" Padding="13,7" ColorType="Highlight" />
                        </StackPanel>
                        <TextBlock Text="支持原版、Forge、Fabric 等任意服务端：第三方核心请直接选择本地 jar 文件。下载完成后会自动填入核心路径，存档与配置将保存在核心所在目录。"
                                   FontSize="12" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="运行环境" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Java 路径" Width="84" VerticalAlignment="Center" />
                            <local:MyTextBox x:Name="TxtMslJava" Width="300" HintText="留空则使用系统默认 Java" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnMslJavaSelect" Text="浏览" Padding="13,7" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="内存分配" Width="84" VerticalAlignment="Center" />
                            <local:MyComboBox x:Name="ComboMslMemory" Width="140">
                                <local:MyComboBoxItem Content="自动" IsSelected="True" />
                                <local:MyComboBoxItem Content="2 GB" />
                                <local:MyComboBoxItem Content="4 GB" />
                                <local:MyComboBoxItem Content="6 GB" />
                                <local:MyComboBoxItem Content="8 GB" />
                            </local:MyComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="附加参数" Width="84" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <local:MyTextBox x:Name="TxtMslArgs" Width="300" HintText="例如 -Dfile.encoding=UTF-8" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,12">
                    <StackPanel Margin="15,13">
                        <TextBlock Text="启动控制" FontSize="15" Foreground="{DynamicResource ColorBrush3}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnMslStart" Text="启动服务器" Padding="20,8" ColorType="Highlight" Margin="0,0,12,0" />
                            <local:MyButton x:Name="BtnMslStop" Text="关闭服务器" Padding="20,8" ColorType="Red" Margin="0,0,18,0" />
                            <TextBlock x:Name="LabMslState" Text="状态：未运行" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource ColorBrushGray2}" />
                        </StackPanel>
                        <TextBlock Text="启动后请切换到【控制台】页面查看实时输出并发送指令；关闭服务器时会自动向服务端发送 stop 指令以安全保存存档。"
                                   FontSize="12" Foreground="{StaticResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </ScrollViewer>

        <!-- 日志输出 -->
        <Grid x:Name="PanLog" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:MyButton x:Name="BtnMslLogClear" Grid.Row="0" Text="清空日志" HorizontalAlignment="Right" Margin="0,0,0,8" Padding="13,7" />
            <TextBox x:Name="TxtMslLog" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{StaticResource ColorBrushBg1}" Foreground="{StaticResource ColorBrushGray1}" FontFamily="Consolas" FontSize="12" Padding="10" />
        </Grid>

        <!-- 控制台 -->
        <Grid x:Name="PanPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,8">
                <TextBlock x:Name="LabMslConsState" Text="● 已停止" VerticalAlignment="Center" FontSize="13" Margin="0,0,14,0" />
                <TextBlock x:Name="LabMslConsCore" Text="" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TxtMslConsole" Grid.Row="0" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="#5FD75F" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" SelectionBrush="#3F7F3F" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:MyTextBox x:Name="TxtMslCmd" Grid.Column="0" HintText="/ (指令)，按回车或点击发送" Margin="0,0,10,0" Height="34" />
                <local:MyButton x:Name="BtnMslSend" Grid.Column="1" Text="发送" Padding="16,7" ColorType="Highlight" Margin="0,0,10,0" />
                <local:MyButton x:Name="BtnMslMore" Grid.Column="2" Text="更多操作" Padding="16,7" Margin="0,0,10,0">
                    <local:MyButton.ContextMenu>
                        <ContextMenu>
                            <local:MyMenuItem Header="清空控制台" Tag="clear" />
                            <local:MyMenuItem Header="重启服务器" Tag="restart" />
                            <local:MyMenuItem Header="打开服务器目录" Tag="folder" />
                            <local:MyMenuItem Header="强制结束进程" Tag="force" />
                        </ContextMenu>
                    </local:MyButton.ContextMenu>
                </local:MyButton>
                <local:MyButton x:Name="BtnMslKill" Grid.Column="3" Text="关服" Padding="16,7" ColorType="Red" />
            </Grid>
        </Grid>
    </Grid>
</local:MyPageRight>
